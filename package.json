{
  "name": "pet-fashion-gestion",
  "version": "1.0.0",
  "private": true,
  "description": "Appointments, dogs and finances for Pet Fashion Dog Salon. Next.js + Supabase PWA.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
